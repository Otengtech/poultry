{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --no-frozen-lockfile --reporter=silent",
  "framework": "vite",
  "functions": {
    "api/*": {
      "maxDuration": 10
    }
  }
}